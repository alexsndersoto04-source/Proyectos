name: Build Void Runner APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

env:
  GODOT_VERSION: 4.2.1
  EXPORT_NAME: VoidRunner

jobs:
  build:
    runs-on: ubuntu-latest
    container:
      image: barichello/godot-ci:4.2.1
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true

      - name: Setup Godot config from image
        run: |
          mkdir -p ~/.local/share/godot/export_templates/
          mkdir -p ~/.config/
          cp -r /root/.config/godot ~/.config/godot
          cp -r /root/.local/share/godot/export_templates/${GODOT_VERSION}.stable \
                 ~/.local/share/godot/export_templates/${GODOT_VERSION}.stable
          echo 'export/android/java_sdk_path = "/usr/lib/jvm/java-17-openjdk-amd64"' >> ~/.config/godot/editor_settings-4.2.tres
          echo "--- Templates android: ---"
          ls ~/.local/share/godot/export_templates/${GODOT_VERSION}.stable/ | grep -iE "android" || echo "(sin android templates)"
          echo "--- Keystore en editor settings: ---"
          grep -i keystore ~/.config/godot/editor_settings-4.2.tres || echo "(sin keystore)"

      - name: Pre-import assets
        run: |
          godot --headless --path "$GITHUB_WORKSPACE" --editor --quit --verbose > import.log 2>&1 || true
          echo "Import exit: $?"
          tail -20 import.log

      - name: Build Android APK
        run: |
          mkdir -p build/android
          godot --headless --verbose --export-debug "Android" \
            "build/android/${EXPORT_NAME}.apk" > export.log 2>&1
          echo "Export exit code: $?"
          echo "--- Archivos en build/android: ---"
          ls -la build/android/ || true
          echo "===INICIO-EXPORT-LOG==="
          cat export.log
          echo "===FIN-EXPORT-LOG==="
          sed 's/%/%25/g' export.log | sed 's/</%3C/g; s/>/%3E/g; s/&/%26/g' | while IFS= read -r line; do
            echo "::error::$line"
          done
          if [ ! -f "build/android/${EXPORT_NAME}.apk" ]; then
            echo "❌ NO se generó el APK"
            exit 1
          fi

      - name: Upload logs (siempre)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: godot-logs
          path: |
            export.log
            import.log
          if-no-files-found: ignore

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: VoidRunner-Android
          path: build/android/*.apk
          if-no-files-found: error
