[sub_resource type="Script" id="2_draw" ]
source_code = "extends Node2D
@export var type: String = \"spike\"
func _draw():
	match type:
		\"spike\":
			var points = PackedVector2Array([Vector2(0, -25), Vector2(-18, 25), Vector2(18, 25)])
			draw_colored_polygon(points, Color(1, 0.25, 0.35))
			draw_polyline(points + PackedVector2Array([points[0]]), Color(1, 0.5, 0.6), 2.0)
		\"block\":
			draw_rect(Rect2(Vector2(-20, -25), Vector2(40, 50)), Color(0.3, 0.6, 1.0))
			draw_rect(Rect2(Vector2(-20, -25), Vector2(40, 50)), Color(0.6, 0.85, 1.0), false, 2.0)
		\"void_orb\":
			draw_circle(Vector2.ZERO, 20, Color(0.6, 0.3, 1.0))
			draw_circle(Vector2.ZERO, 20, Color(0.9, 0.6, 1.0), false, 2.0)
			draw_circle(Vector2(-5, -5), 5, Color(1,1,1,0.8))
func set_type(t):
	type = t
	queue_redraw()
"

