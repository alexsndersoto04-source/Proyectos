[sub_resource type="Script" id="Script_visual"]
source_code = "extends Node2D
@export var type: String = \"shield\"
func _draw():
	match type:
		\"shield\":
			draw_circle(Vector2.ZERO, 18, Color(0.2, 0.8, 1.0))
			draw_circle(Vector2.ZERO, 18, Color(0.6, 0.9, 1.0), false, 2.5)
			draw_circle(Vector2.ZERO, 8, Color(1,1,1,0.9))
			draw_circle(Vector2(-3, -4), 3, Color(1,1,1,0.6))
		\"slow\":
			draw_circle(Vector2.ZERO, 18, Color(0.3, 1.0, 0.6))
			draw_circle(Vector2.ZERO, 18, Color(0.6, 1.0, 0.8), false, 2.5)
			# reloj
			draw_line(Vector2.ZERO, Vector2(0, -10), Color(1,1,1,0.9), 2)
			draw_line(Vector2.ZERO, Vector2(8, 0), Color(1,1,1,0.9), 2)
		\"coin\":
			draw_circle(Vector2.ZERO, 16, Color(1.0, 0.85, 0.2))
			draw_circle(Vector2.ZERO, 16, Color(1.0, 0.95, 0.6), false, 2)
			draw_circle(Vector2.ZERO, 8, Color(1,1,1,0.8))
func set_type(t):
	type = t
	queue_redraw()
"

