[sub_resource type="Script" id="2"]
source_code = "extends AnimatedSprite2D
func _ready(): play(\"run\")
func _process(_d): queue_redraw()
func _notification(what):
	if what == NOTIFICATION_DRAW:
		match animation:
			\"run\":
				draw_rect(Rect2(Vector2(-16, -22), Vector2(32, 36)), Color(0.9, 0.9, 1.0))
				draw_circle(Vector2(4, -28), 14, Color(0.95, 0.95, 1.0))
				draw_circle(Vector2(10, -30), 2, Color(0.4, 0.4, 1.0))
				var t = Time.get_ticks_msec() / 100.0
				var leg_offset = sin(t) * 6
				draw_rect(Rect2(Vector2(-12 + leg_offset, 12), Vector2(10, 18)), Color(0.7, 0.7, 0.9))
				draw_rect(Rect2(Vector2(2 - leg_offset, 12), Vector2(10, 18)), Color(0.6, 0.6, 0.85))
			\"jump\":
				draw_rect(Rect2(Vector2(-14, -20), Vector2(30, 32)), Color(0.9, 0.9, 1.0))
				draw_circle(Vector2(2, -26), 13, Color(1.0, 1.0, 1.0))
				draw_circle(Vector2(8, -28), 3, Color(0.4, 0.4, 1.0))
				draw_rect(Rect2(Vector2(-8, 10), Vector2(22, 12)), Color(0.6, 0.6, 0.9))
			\"fall\":
				draw_rect(Rect2(Vector2(-15, -18), Vector2(30, 32)), Color(0.85, 0.85, 0.95))
				draw_circle(Vector2(0, -26), 12, Color(0.95, 0.95, 1.0))
				draw_circle(Vector2(6, -26), 2, Color(0.3,0.3,0.5))
			\"double_jump\":
				draw_rect(Rect2(Vector2(-16, -22), Vector2(34, 36)), Color(0.7, 0.6, 1.0))
				draw_circle(Vector2(4, -28), 14, Color(0.8, 0.7, 1.0))
				draw_circle(Vector2(12, -30), 4, Color(1.0, 0.8, 0.3))
				draw_circle(Vector2.ZERO, 28, Color(0.5, 0.3, 1.0, 0.25))
			\"die\":
				draw_rect(Rect2(Vector2(-16, -10), Vector2(32, 20)), Color(1.0, 0.3, 0.3))
				draw_circle(Vector2(0, -22), 10, Color(1.0, 0.5, 0.5))
				draw_line(Vector2(-4, -26), Vector2(4, -18), Color(0.2,0.2,0.2), 2)
				draw_line(Vector2(4, -26), Vector2(-4, -18), Color(0.2,0.2,0.2), 2)
"

[sub_resource type="Script" id="3"]
source_code = "extends Node2D
func _draw():
	draw_circle(Vector2.ZERO, 30, Color(0.2, 0.7, 1.0, 0.15))
	draw_circle(Vector2.ZERO, 30, Color(0.4, 0.85, 1.0, 0.8), false, 3)
	draw_circle(Vector2.ZERO, 34, Color(0.2, 0.7, 1.0, 0.3), false, 1.5)
func _process(_d):
	rotation += 0.05
	queue_redraw()
"

